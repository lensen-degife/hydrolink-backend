// HydroLink - Prisma schema (MySQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum OtpPurpose {
  REGISTER
  RESET
}

enum PaymentMethod {
  TELEBIRR
  CBE
  AWASH
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BillStatus {
  UNPAID
  PAID
  OVERDUE
  PARTIAL
}

enum RequestType {
  LEAK
  NO_SUPPLY
  LOW_PRESSURE
  METER_ISSUE
  BILLING_ISSUE
  OTHER
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupplyStatus {
  AVAILABLE
  SCHEDULED_OFF
  UNSCHEDULED_OFF
  LOW_PRESSURE
}

enum NotificationType {
  BILL
  PAYMENT
  ANNOUNCEMENT
  SCHEDULE
  REQUEST
  SYSTEM
}

enum DevicePlatform {
  IOS
  ANDROID
}

// ---------- MODELS ----------

model User {
  id             String   @id @default(uuid())
  fullName       String
  email          String   @unique
  phone          String   @unique
  passwordHash   String
  accountNumber  String   @unique
  kebele         String?
  isVerified     Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  otps            Otp[]
  bills           Bill[]
  payments        Payment[]
  usageRecords    UsageRecord[]
  serviceRequests ServiceRequest[]
  notifications   Notification[]
  deviceTokens    DeviceToken[]
  refreshTokens   RefreshToken[]

  @@index([kebele])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Otp {
  id        String     @id @default(uuid())
  userId    String?
  email     String
  code      String
  purpose   OtpPurpose
  consumed  Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
}

model Bill {
  id          String     @id @default(uuid())
  userId      String
  periodMonth Int
  periodYear  Int
  usageM3     Float
  amountEtb   Decimal    @db.Decimal(10, 2)
  dueDate     DateTime
  status      BillStatus @default(UNPAID)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  billId        String
  amountEtb     Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionRef String?      @unique
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([billId])
}

model Schedule {
  id          String       @id @default(uuid())
  kebele      String
  dayOfWeek   Int          // 0=Sunday ... 6=Saturday
  startTime   String       // "06:00"
  endTime     String       // "10:00"
  status      SupplyStatus @default(SCHEDULED_OFF)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kebele])
  @@index([kebele, dayOfWeek])
}

model UsageRecord {
  id         String   @id @default(uuid())
  userId     String
  periodMonth Int
  periodYear  Int
  usageM3    Float
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, periodMonth, periodYear])
}

model ServiceRequest {
  id          String        @id @default(uuid())
  userId      String
  type        RequestType
  description String        @db.Text
  location    String?
  urgency     Urgency       @default(MEDIUM)
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String   @db.Text
  kebele    String?  // null = all kebeles
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kebele])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
